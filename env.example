# Copy to .env for local dev. In production, set these in Render's dashboard.

# ============================================================
#  Email (Resend) — optional
# ============================================================
# Sign up at https://resend.com (free: 3,000 emails/month)
# Dashboard → API Keys → Create API Key → copy the value here
# Without this, emails are queued to outbox.jsonl instead of sent.
RESEND_API_KEY=

# Sender. For testing, leave the default — it's Resend's verified test sender.
# For production, verify your own domain in Resend, then change to e.g.:
#   EMAIL_FROM=Audit Wizard <reports@yourdomain.com>
EMAIL_FROM=Audit Wizard <onboarding@resend.dev>

# Public URL of your deployed app — used in email links.
# Example: https://audit-wizard.onrender.com
# If empty, emails link to a placeholder URL.
PUBLIC_BASE_URL=

# ============================================================
#  Audit defaults
# ============================================================

# Hard cap on max_pages (form prevents going above this).
# 100 is safe for Render free. Bump to 1000 once you upgrade to Starter.
MAX_PAGES_LIMIT=100

# What the form pre-fills.
DEFAULT_MAX_PAGES=30

# ============================================================
#  Flask
# ============================================================

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Required in production. Without it, sessions reset every time the
# app restarts.
FLASK_SECRET_KEY=

# Logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============================================================
#  Local dev only
# ============================================================
# PORT=5000
# FLASK_HOST=127.0.0.1
